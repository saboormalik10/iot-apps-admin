# ══════════════════════════════════════════════════════════════════════════════
#  Observator Standalone — the site's settings
# ══════════════════════════════════════════════════════════════════════════════
#
#  ONE file for the API, the sensor stream and the web portal. On an installed PC
#  it is <data folder>\config\observator.env (default
#  C:\ObservatorData\config\observator.env), written by the installer with every
#  CHANGE_ME filled in; an upgrade keeps it and only adds new settings.
#
#  Settings are read when a service starts: after changing anything here, restart
#  the services (status.cmd shows them; or restart the PC).
#
#  In development the API reads backend/.env and the portal web/.env.local instead.

# ── The API ───────────────────────────────────────────────────────────────────

# Port the API listens on. Only the web portal on this PC talks to it, so by
# default it listens on this PC alone (API_HOST=127.0.0.1); the portal on :3201 is
# what the site network uses, and it passes the live socket through.
PORT=3200
API_HOST=127.0.0.1
NODE_ENV=production
# Proxies in front of the API. Leave unset: 1 while the API is on this PC alone
# (the portal passes each browser's address on), 0 if API_HOST opens it to the network.
# TRUST_PROXY=

# The local database. Never a cloud database.
MONGO_URI=mongodb://127.0.0.1:27017/observator_standalone?replicaSet=rs0&directConnection=true

# Sign-in tokens. Two different long random strings — generate each with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=CHANGE_ME
JWT_REFRESH_SECRET=CHANGE_ME

# The web portal's address, as people on the site network type it. Used in
# password-reset emails (when email is set up) and to allow the portal through.
FRONTEND_URL=http://localhost:3201
CORS_ORIGIN=http://localhost:3201

# Password for the API reference pages at http://localhost:3200/api (on this PC)
SWAGGER_USER=docs
SWAGGER_PASSWORD=CHANGE_ME

# ── The web portal ───────────────────────────────────────────────────────────
# The address people on the site network open: http://<this PC>:WEB_PORT
WEB_PORT=3201
# 0.0.0.0 = every network card on this PC.
WEB_HOST=0.0.0.0
# How the portal reaches the API on this PC. 127.0.0.1, not "localhost": that can
# resolve to IPv6 first, where the API is not listening.
BACKEND_URL=http://127.0.0.1:3200/v1
# Encrypts the sign-in cookie. A long random string (the installer makes one).
SESSION_SECRET=CHANGE_ME
# Sign people out after this many minutes without activity.
SESSION_IDLE_MINUTES=30
# true only if the portal is served over HTTPS — on plain http:// a secure cookie
# is never sent back, and nobody could sign in.
SESSION_COOKIE_SECURE=false

# Optional HTTPS. Most site networks have no certificate authority, and a
# self-signed certificate warns every visitor, so the portal speaks plain http by
# default — which means the sign-in cookie crosses the site network in the clear.
# If the site HAS a certificate for this PC (from its own CA), point these at the
# certificate and its private key, set SESSION_COOKIE_SECURE=true above, and
# restart the portal service.
# WEB_TLS_CERT=C:\ObservatorData\config\station.crt
# WEB_TLS_KEY=C:\ObservatorData\config\station.key

# ── First start (installer) ──────────────────────────────────────────────────
# Used only on a new, empty database, to create the site and its station. Changing
# them later does nothing — edit those in the portal. The first administrator is
# created by the installer and is NOT kept in this file.

STANDALONE_SITE_NAME=Weather Station
# IANA timezone; decides where each day starts. Defaults to this PC's timezone.
STANDALONE_TIMEZONE=
STANDALONE_COUNTRY=AU
STANDALONE_STATION_NAME=GMX551 Station
# Development only: create this administrator on start if none exists. There is NO
# default password. The installer never writes these here.
# STANDALONE_ADMIN_EMAIL=
# STANDALONE_ADMIN_PASSWORD=

# The data folder: uploads (the logo) live in its "uploads" folder. The installer
# sets it; in development it defaults to a "data" folder beside the API.
STANDALONE_DATA_DIR=

# ── Accounts ─────────────────────────────────────────────────────────────────
# true = the sign-in page offers "Create an account". New accounts wait, inactive,
# until an administrator approves them on the Users screen. Off: only
# administrators add people.
STANDALONE_SELF_SIGNUP=false

# ── The sensor stream ────────────────────────────────────────────────────────
# Who opens the connection:
#   listen  — the converter connects IN to this PC (what the client described)
#   connect — this PC dials the converter (how a MOXA NPort usually works)
STREAM_MODE=listen

# listen: the TCP port the converter connects to (client: 4000).
STREAM_TCP_PORT=4000
# Address to listen on. 0.0.0.0 = every network card on this PC.
STREAM_HOST=0.0.0.0

# connect: the converter's address and port.
STREAM_REMOTE_HOST=
STREAM_REMOTE_PORT=4000

# How the rain gauge reports, once it is known:
#   total    — a running total that may reset (Gill PRECIPT; the default)
#   interval — the rain since the previous reading
STREAM_RAIN_MODE=total

# The sensor's column order, used until it sends its own header line (it does so
# only at power-up). Blank = Gill's default:
#   NODE,DIR,SPEED,CDIR,CSPEED,TEMP,RH,PRESS,PRECIPT,PRECIPI,STATUS,CHECK
STREAM_FIELDS=

# Checksums on each reading:
#   auto    — check it when the reading carries one (default)
#   require — refuse any reading without one
#   off     — never check
STREAM_CHECKSUM=auto

# Wind direction: corrected (the compass-corrected CDIR, when sent) or raw (DIR).
STREAM_DIRECTION=corrected

# Rarely needed:
# STREAM_ENABLED=true            false switches the listener off
# STREAM_STATION_BLE_ID=         which station to write to, if there is more than one
# STREAM_FLUSH_GRACE_MS=5000     wait after a minute ends before writing it
# STREAM_IDLE_TIMEOUT_MS=300000  close a silent connection so the converter reconnects
# STREAM_MAX_LINE_BYTES=4096     longest reading accepted
# STREAM_REDIAL_MS=2000          connect: first wait before redialling (doubles to 30 s)

# ── Backups (the nightly task, backup-now.cmd) ───────────────────────────────
# Where backups go. Blank = the data folder's "backups". A second drive or a network
# share survives this disk failing; a share must let this PC's computer account write.
BACKUP_DIR=
# How many nightly backups to keep. The data is never deleted, so each is a full copy.
BACKUP_KEEP=14

# ── Email (optional; off unless set) ─────────────────────────────────────────
# Alerts always appear in the portal. Email needs a mail server this PC can reach.
# EMAIL_HOST=smtp.example.local
# EMAIL_PORT=587
# EMAIL_MAILER=alerts@example.com
# EMAIL_PASSWORD=
# EMAIL_FROM=Weather Station <alerts@example.com>
