{
  "name": "observator-standalone-api",
  "version": "0.1.0",
  "description": "Observator Instruments — Cloud API Backend",
  "main": "dist/main.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/main.ts",
    "build": "nest build",
    "start": "node dist/main",
    "seed": "ts-node src/scripts/seed.ts",
    "reset-password": "ts-node src/scripts/reset-password.ts",
    "setup-site": "ts-node src/scripts/setup-site.ts",
    "backfill:daily-summary": "ts-node src/scripts/backfill-daily-summary.ts",
    "qc:distribution": "ts-node src/scripts/qc-distribution.ts",
    "storage:report": "ts-node src/scripts/storage-report.ts",
    "field-presence": "ts-node src/scripts/field-presence.ts",
    "capacity-report": "ts-node src/scripts/capacity-report.ts",
    "purge:legacy-rows": "ts-node src/scripts/purge-legacy-rows.ts",
    "test": "jest --config test/jest-e2e.json --runInBand",
    "lint": "eslint src --ext .ts",
    "format": "prettier --write src/**/*.ts",
    "migrate:metrecord-index": "ts-node src/scripts/migrate-metrecord-index.ts",
    "migrate:device-bleid-index": "ts-node src/scripts/migrate-device-bleid-index.ts",
    "check:swagger": "ts-node src/scripts/check-swagger-sync.ts",
    "seed:accounts": "ts-node src/scripts/seed-accounts.ts",
    "backup:db": "ts-node src/scripts/backup-db.ts",
    "migrate:device-ingest-fields": "ts-node src/scripts/migrate-device-ingest-fields.ts",
    "migrate:daily-summary-key": "ts-node src/scripts/migrate-daily-summary-key.ts",
    "migrate:roles": "ts-node src/scripts/migrate-roles.ts",
    "restore:db": "ts-node src/scripts/restore-db.ts",
    "loadtest:rollup": "ts-node src/scripts/load-test-rollup.ts",
    "sync:indexes": "ts-node src/scripts/sync-indexes.ts",
    "migrate:strip-nulls": "ts-node src/scripts/migrate-strip-null-measures.ts",
    "migrate:role-scoping": "ts-node src/scripts/migrate-role-scoping.ts",
    "verify:stats": "ts-node src/scripts/verify-stats.ts",
    "verify:analytics": "ts-node src/scripts/verify-analytics.ts"
  },
  "dependencies": {
    "@nestjs/common": "^10.4.22",
    "@nestjs/core": "^10.4.22",
    "@nestjs/event-emitter": "^2.1.1",
    "@nestjs/mongoose": "^10.1.0",
    "@nestjs/platform-express": "^10.4.22",
    "@nestjs/platform-socket.io": "^10.4.22",
    "@nestjs/swagger": "^7.4.2",
    "@nestjs/throttler": "^5.2.0",
    "@nestjs/websockets": "^10.4.22",
    "bcryptjs": "^3.0.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.4",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "file-type": "^16.5.4",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^8.4.0",
    "morgan": "^1.10.1",
    "multer": "^2.1.1",
    "nodemailer": "^9.0.5",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "socket.io": "^4.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.9",
    "@nestjs/testing": "^10.4.22",
    "@types/bcryptjs": "^3.0.0",
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.12",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.10",
    "@types/multer": "^2.1.0",
    "@types/node": "^20.14.0",
    "@types/nodemailer": "^8.0.0",
    "@types/supertest": "^6.0.2",
    "@typescript-eslint/eslint-plugin": "^8.59.3",
    "@typescript-eslint/parser": "^8.59.3",
    "eslint": "^10.3.0",
    "eslint-config-prettier": "^10.1.8",
    "jest": "^29.7.0",
    "prettier": "^3.8.3",
    "socket.io-client": "^4.8.3",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.4.5"
  }
}
