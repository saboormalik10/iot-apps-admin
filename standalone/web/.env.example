# ── Observator Standalone — web app environment ──────────────────────────────
# Mind the server/browser split: only NEXT_PUBLIC_* vars reach the browser.

# Server-only — the API this app proxies to (includes the /v1 prefix). On the site
# PC both run on the same machine.
BACKEND_URL=http://127.0.0.1:3200/v1

# The live-update socket needs no setting: browsers connect to the portal's own
# address and server.mjs hands the socket to the API above.

# Web port and the address to listen on (server.mjs). 0.0.0.0 = the site network.
PORT=3201
WEB_HOST=0.0.0.0

# Server-only — 32+ char secret used to encrypt the session cookie.
SESSION_SECRET=change_me_to_a_long_random_string_at_least_32_chars

# Server-only — idle session timeout (minutes). Default 30.
SESSION_IDLE_MINUTES=30

# Server-only — set to true ONLY when HTTPS is put in front of the portal. Over
# plain HTTP a Secure cookie is dropped by the browser and nobody can stay signed in.
SESSION_COOKIE_SECURE=false

# Feature flags (comma-separated flag keys to force-enable). See lib/config/flags.ts.
NEXT_PUBLIC_FEATURE_FLAGS=
