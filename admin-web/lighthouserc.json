{
  "ci": {
    "collect": {
      "url": [
        "http://localhost:3001/login",
        "http://localhost:3001/",
        "http://localhost:3001/devices",
        "http://localhost:3001/sessions"
      ],
      "numberOfRuns": 1,
      "settings": {
        "preset": "desktop",
        "skipAudits": ["uses-http2", "canonical", "is-crawlable"]
      }
    },
    "assert": {
      "assertMatrix": [
        {
          "_comment": "Every route EXCEPT the bare dashboard root. LHCI applies every matching entry, so this must not also match '/' or its strict CLS rule would override the documented carve-out below.",
          "matchingUrlPattern": "^http://localhost:3001/.+",
          "assertions": {
            "categories:performance": ["error", { "minScore": 0.8 }],
            "categories:accessibility": ["error", { "minScore": 0.95 }],
            "categories:best-practices": ["warn", { "minScore": 0.9 }],
            "largest-contentful-paint": ["error", { "maxNumericValue": 2500 }],
            "cumulative-layout-shift": ["error", { "maxNumericValue": 0.1 }],
            "total-blocking-time": ["error", { "maxNumericValue": 400 }],
            "unused-javascript": ["warn", { "maxNumericValue": 250000 }]
          }
        },
        {
          "_comment": "The live dashboard: charts + a WebGL map + a socket, so it is both the heaviest route and the noisiest to measure. Its budgets carry headroom over the observed run-to-run spread deliberately — a gate that fails at random gets switched off, which is worse than a looser one that means something. CLS is a warn: a known, documented gap (see LIGHTHOUSE.md).",
          "matchingUrlPattern": "^http://localhost:3001/$",
          "assertions": {
            "categories:performance": ["error", { "minScore": 0.7 }],
            "categories:accessibility": ["error", { "minScore": 0.95 }],
            "largest-contentful-paint": ["error", { "maxNumericValue": 3000 }],
            "total-blocking-time": ["error", { "maxNumericValue": 800 }],
            "cumulative-layout-shift": ["warn", { "maxNumericValue": 0.1 }]
          }
        }
      ]
    },
    "upload": {
      "target": "filesystem",
      "outputDir": ".lighthouseci"
    }
  }
}
