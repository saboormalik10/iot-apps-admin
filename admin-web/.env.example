# ── admin-web environment ─────────────────────────────────────────────────────
# Mind the server/browser split: only NEXT_PUBLIC_* vars reach the browser.

# Server-only — the BFF proxy targets this backend origin (includes the /v1 prefix).
BACKEND_URL=https://iot-apps-admin.onrender.com/v1

# Browser-visible — the socket.io client connects FROM the browser to /v1/ws.
# Must be a NEXT_PUBLIC_* var (the server BACKEND_URL is not exposed to the client).
NEXT_PUBLIC_BACKEND_WS_URL=wss://iot-apps-admin.onrender.com

# Server-only — 32+ char secret used to encrypt the iron-session cookie.
SESSION_SECRET=change_me_to_a_long_random_string_at_least_32_chars

# Server-only — idle session timeout (minutes). Default 30.
SESSION_IDLE_MINUTES=30

# Observability (optional; no-op when unset).
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# Feature flags (comma-separated flag keys to force-enable). See lib/config/flags.ts.
NEXT_PUBLIC_FEATURE_FLAGS=

# ── Local dev / CI only (the simulator + seed hit the backend directly) ────────
# MOBILE_API_KEY=obs_mob_...
# MOBILE_ORG_ID=<org ObjectId>
