# maplibre-gl@4 pulls a build-time transitive (@mapbox/jsonlint-lines-primitives)
# whose `engines.node >= 22` gate trips yarn classic on our Node 20 toolchain.
# It's a style-spec validation dep only (not used at runtime), so we relax the
# engine check to keep `yarn install` deterministic across dev + CI (both Node 20).
--ignore-engines true
ignore-engines true
