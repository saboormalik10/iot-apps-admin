# The portal's sign-in. Every page needs it; "Sign out" ends the session.
# Set these in Vercel → Project → Settings → Environment Variables, and in
# .env.local for local development (never committed). Changing either signs
# every browser out.
SITE_EMAIL=
SITE_PASSWORD=

# Optional — Cloudflare Turnstile on sign-in and password reset. Without these
# the widget runs on Cloudflare's test key and the server check is skipped.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
