PORT=3000
NODE_ENV=production

# MongoDB Atlas — use the direct URI (not mongodb+srv://) if TXT DNS fails
MONGO_URI=mongodb://USER:PASSWORD@HOST1:27017,HOST2:27017,HOST3:27017/observator?replicaSet=REPLICA_SET&authSource=admin&tls=true

# JWT — generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=CHANGE_ME_LONG_RANDOM_STRING
JWT_REFRESH_SECRET=CHANGE_ME_ANOTHER_LONG_RANDOM_STRING

# API Base URL (no trailing slash)
API_BASE_URL=https://observator-backend.onrender.com

# Admin-web (frontend) origin — used to build invite / password-reset email links
# (those pages live on admin-web, NOT the backend). No trailing slash.
FRONTEND_URL=https://admin.observator.com

# Swagger docs password gate (HTTP Basic Auth) — REQUIRED for /api to load.
# If unset, the docs return 503 (fail-closed). Does not affect the /v1 API.
SWAGGER_USER=docs
SWAGGER_PASSWORD=CHANGE_ME_DOCS_PASSWORD

# CORS allow-list (Month 5) — comma-separated dashboard origin(s). Leave unset
# for wildcard (dev only). Mobile apps use the API key, unaffected by this.
CORS_ORIGIN=https://dashboard.observator.com

# Sentry crash reporting (Month 5) — leave blank to disable.
SENTRY_DSN=

# Public share links (Month 6) — base URL used to build shareable /public/:token
# links. Leave unset to return a relative /v1/public/:token path.
PUBLIC_SHARE_BASE_URL=https://dashboard.observator.com

# Push notifications — real device push via Firebase Cloud Messaging (Android
# directly, iOS via FCM→APNs). Leave unset to disable: the notification feed and
# the dashboard WebSocket keep working, only device push becomes a no-op.
#
# Setup:
#   1. Firebase console → Project settings → Service accounts → Generate new
#      private key. That downloads a JSON file.
#   2. Encode it:  base64 -w0 service-account.json
#   3. Paste the result below (one line, no quotes).
#   4. iOS only: Apple Developer → Keys → create an APNs Auth Key (.p8) and
#      upload it under Firebase → Project settings → Cloud Messaging. The
#      backend never talks to APNs itself.
FCM_SERVICE_ACCOUNT_B64=
# …or paste the raw JSON instead (leave FCM_SERVICE_ACCOUNT_B64 unset if you do):
# FCM_SERVICE_ACCOUNT_JSON=

# Nodemailer — Gmail SMTP with App Password
EMAIL_MAILER=your-gmail@gmail.com
EMAIL_PASSWORD=xxxx xxxx xxxx xxxx
EMAIL_FROM=Observator <your-gmail@gmail.com>

# Mobile static API key — hardcode this in NEP-LINK and MET-LINK apps
# Generate with: node -e "console.log('obs_mob_' + require('crypto').randomBytes(32).toString('hex'))"
MOBILE_API_KEY=obs_mob_CHANGE_ME
# MOBILE_API_KEY / MOBILE_ORG_ID — UNUSED since M15 W3.
# The mobile auth routes are commented out (auth/auth.controller.ts) and the
# static API-key path was removed earlier still. Kept documented so a future
# re-enable knows what they were for.
# MOBILE_ORG_ID=6a437ef2ee000f4be3eb5b14

# Cloudinary — media storage (NEP session files + MET record pictures).
# Either set the single CLOUDINARY_URL (copy from the Cloudinary dashboard)…
CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME
# …or the three split vars instead (leave CLOUDINARY_URL unset if you use these):
# CLOUDINARY_CLOUD_NAME=your-cloud-name
# CLOUDINARY_API_KEY=your-api-key
# CLOUDINARY_API_SECRET=your-api-secret

# ── E2E test credentials (development only) ─────────────────────────────────
# Passwords for the seeded e2e accounts. Set these to whatever
# `src/scripts/reset-account-password.ts` was run with. Never set in production.
E2E_ADMIN_PASSWORD=
E2E_VIEWER_PASSWORD=

# Number of proxies in front of the API (1 for a single load balancer).
# REQUIRED for per-IP rate limiting to work behind a balancer — without it every
# request looks like it comes from the balancer and the whole customer base
# shares one bucket. Deliberately a hop count, never `true`: trusting the
# client-supplied X-Forwarded-For lets an attacker spoof a fresh IP per request.
# Leave unset (0) when the API is exposed directly.
TRUST_PROXY=

# CORS_ORIGIN is REQUIRED in production — the API refuses to start without it
# rather than falling back to a wildcard.
